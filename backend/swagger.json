{
  "openapi": "3.0.0",
  "info": {
    "title": "Burgerizza Inventory API Documentation",
    "version": "1.0.0",
    "description": "API documentation for the Inventory module in the Burgerizza Restaurant Management System."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/inventory": {
      "get": {
        "summary": "Get all inventory items",
        "description": "Retrieve a list of inventory items with filtering, pagination, and sorting. Restricted to Admin and Manager/Employee roles.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (defaults to 1)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page (defaults to 10, max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by item category",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isActive",
            "in": "query",
            "description": "Filter by active status ('true' or 'false')",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "lowStock",
            "in": "query",
            "description": "Filter items with quantity <= minimumStock ('true' or 'false')",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search keyword matching name or supplier (case-insensitive)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Field name to sort by",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["name", "quantity", "minimumStock", "category", "createdAt"]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort order ('asc' or 'desc')",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of inventory items retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Invalid isActive filter. Must be true or false."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access. No token or invalid token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Access denied. No token provided."
                }
              }
            }
          },
          "403": {
            "description": "Forbidden. Insufficient permissions (e.g. Customer role).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Forbidden. Access denied."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new inventory item",
        "description": "Add a new inventory item to the system. Restricted to Admin role only.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInventoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inventory item created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Inventory"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error or duplicate name conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "duplicateName": {
                    "summary": "Duplicate name error",
                    "value": {
                      "success": false,
                      "message": "Inventory item with this name already exists."
                    }
                  },
                  "validationError": {
                    "summary": "Missing required field error",
                    "value": {
                      "success": false,
                      "message": "Unit is required."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden. Insufficient permissions (e.g. Manager or Customer role).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/inventory/low-stock": {
      "get": {
        "summary": "Get low stock inventory items",
        "description": "Retrieve a list of inventory items where quantity <= minimumStock. Supports pagination and sorting. Restricted to Admin and Manager/Employee roles.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["name", "quantity", "minimumStock", "category", "createdAt"]
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Low stock items retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized."
          },
          "403": {
            "description": "Forbidden."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/inventory/{id}": {
      "get": {
        "summary": "Get inventory item by ID",
        "description": "Retrieve detailed information of a single inventory item. Restricted to Admin and Manager/Employee roles.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Mongoose ObjectId of the inventory item",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory item details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Inventory"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ObjectId format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Invalid inventory ID format."
                }
              }
            }
          },
          "404": {
            "description": "Inventory item not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Inventory item not found."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized."
          },
          "403": {
            "description": "Forbidden."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "summary": "Update inventory item",
        "description": "Update details of an existing inventory item. Partial updates are supported. Restricted to Admin role only.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateInventoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inventory item updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Success"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Inventory"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error, invalid ID format, or duplicate name conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Inventory item not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized."
          },
          "403": {
            "description": "Forbidden."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "summary": "Soft delete inventory item",
        "description": "Deactivate an inventory item by setting its isActive status to false. Restricted to Admin role only.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory item soft deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Inventory item soft deleted successfully."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Inventory"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID format or item is already inactive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Inventory item is already inactive."
                }
              }
            }
          },
          "404": {
            "description": "Inventory item not found."
          },
          "401": {
            "description": "Unauthorized."
          },
          "403": {
            "description": "Forbidden."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/inventory/{id}/restore": {
      "patch": {
        "summary": "Restore soft deleted inventory item",
        "description": "Reactivate an inactive inventory item by setting its isActive status back to true. Restricted to Admin role only.",
        "tags": ["Inventory"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory item restored successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Inventory item restored successfully."
                    },
                    "data": {
                      "$ref": "#/components/schemas/Inventory"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID format or item is already active.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Inventory item is already active."
                }
              }
            }
          },
          "404": {
            "description": "Inventory item not found."
          },
          "401": {
            "description": "Unauthorized."
          },
          "403": {
            "description": "Forbidden."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide bearer token inside Authorization header: `Bearer <JWT_TOKEN>`"
      }
    },
    "schemas": {
      "Inventory": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "60c72b2f9b1d8b2a3c8e4d14"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Beef Patty"
          },
          "category": {
            "type": "string",
            "example": "Meat"
          },
          "unit": {
            "type": "string",
            "enum": ["kg", "g", "litre", "ml", "piece", "pack"],
            "example": "piece"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "example": 100
          },
          "minimumStock": {
            "type": "integer",
            "minimum": 0,
            "example": 20
          },
          "supplier": {
            "type": "string",
            "maxLength": 100,
            "example": "Premium Meat Co"
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "example": "Keep frozen at all times."
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-14T20:50:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-14T20:51:30.000Z"
          }
        }
      },
      "CreateInventoryRequest": {
        "type": "object",
        "required": ["name", "unit", "quantity", "minimumStock"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Beef Patty"
          },
          "category": {
            "type": "string",
            "example": "Meat"
          },
          "unit": {
            "type": "string",
            "enum": ["kg", "g", "litre", "ml", "piece", "pack"],
            "example": "piece"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 100
          },
          "minimumStock": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "example": 20
          },
          "supplier": {
            "type": "string",
            "maxLength": 100,
            "example": "Premium Meat Co"
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "example": "Keep frozen"
          },
          "isActive": {
            "type": "boolean",
            "default": true,
            "example": true
          }
        }
      },
      "UpdateInventoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Beef Patty"
          },
          "category": {
            "type": "string",
            "example": "Meat"
          },
          "unit": {
            "type": "string",
            "enum": ["kg", "g", "litre", "ml", "piece", "pack"],
            "example": "piece"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "example": 120
          },
          "minimumStock": {
            "type": "integer",
            "minimum": 0,
            "example": 20
          },
          "supplier": {
            "type": "string",
            "maxLength": 100,
            "example": "Super Premium Meat Co"
          },
          "notes": {
            "type": "string",
            "maxLength": 500,
            "example": "Keep frozen"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "InventoryListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "data": {
            "type": "object",
            "properties": {
              "inventory": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Inventory"
                }
              },
              "pagination": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "example": 23
                  },
                  "page": {
                    "type": "integer",
                    "example": 1
                  },
                  "limit": {
                    "type": "integer",
                    "example": 10
                  },
                  "pages": {
                    "type": "integer",
                    "example": 3
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Detailed error explanation here"
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "example": null
          }
        }
      }
    }
  }
}
